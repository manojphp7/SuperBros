{
  "extends": "@tsconfig/expo/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,         // ✅ Add this
    "allowSyntheticDefaultImports": true // (optional, but commonly used with esModuleInterop)
